# PMTiles Server Configuration

# Space-separated list of allowed referrer hostnames
# Add your domain(s) here to restrict tile access
# Default: localhost 127.0.0.1 example.com
ALLOWED_REFERRERS=localhost 127.0.0.1 yourdomain.com www.yourdomain.com

# To use: Copy this file to .env and customize the values
# cp .env.example .env
