{
  "version": 8,
  "name": "Hungarian Map - Dark",
  "metadata": {"maputnik:renderer": "mbgljs"},
  "sources": {
    "hungary-hiking": {
      "type": "vector",
      "url": "pmtiles://http://localhost:8080/tiles/hungary-map.pmtiles",
      "attribution": "© OpenStreetMap contributors"
    }
  },
  "glyphs": "http://localhost:8080/fonts/{fontstack}/{range}.pbf",
  "layers": [
    {
      "id": "background",
      "type": "background",
      "minzoom": 0,
      "layout": {"visibility": "visible"},
      "paint": {
        "background-color": [
          "interpolate",
          ["exponential", 1],
          ["zoom"],
          5,
          "hsl(220, 20%, 14%)",
          14,
          "hsl(220, 10%, 18%)"
        ]
      }
    },
    {
      "id": "forest",
      "type": "fill",
      "source": "hungary-hiking",
      "source-layer": "landuse",
      "minzoom": 9,
      "filter": ["==", "type", "forest"],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "hsl(91, 38%, 14%)", "fill-opacity": 0.5}
    },
    {
      "id": "grass",
      "type": "fill",
      "source": "hungary-hiking",
      "source-layer": "landuse",
      "minzoom": 11,
      "filter": ["in", "type", "grass", "meadow", "park"],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "hsla(90, 35%, 9%, 0.3)"}
    },
    {
      "id": "farmland",
      "type": "fill",
      "source": "hungary-hiking",
      "source-layer": "landuse",
      "minzoom": 11,
      "filter": ["in", "type", "farmland", "orchard", "vineyard"],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "hsla(58, 55%, 13%, 0.4)"}
    },
    {
      "id": "industrial",
      "type": "fill",
      "source": "hungary-hiking",
      "source-layer": "landuse",
      "minzoom": 11,
      "filter": ["in", "type", "industrial", "commercial", "retail"],
      "layout": {"visibility": "visible"},
      "paint": {"fill-color": "hsla(220, 20%, 12%, 0.6)"}
    },
    {
      "id": "water",
      "type": "fill",
      "source": "hungary-hiking",
      "source-layer": "water",
      "layout": {"visibility": "visible"},
      "paint": {
        "fill-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          "hsl(210, 61%, 20%)",
          14,
          "hsl(210, 61%, 18%)"
        ]
      }
    },
    {
      "id": "waterway",
      "type": "line",
      "source": "hungary-hiking",
      "source-layer": "waterway",
      "minzoom": 8,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "hsl(210, 61%, 22%)",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          8,
          0.5,
          12,
          1.5,
          14,
          2.5
        ]
      }
    },
    {
      "id": "boundaries",
      "type": "line",
      "source": "hungary-hiking",
      "source-layer": "boundaries",
      "minzoom": 3,
      "layout": {"line-cap": "round", "line-join": "round"},
      "paint": {
        "line-color": "hsl(0, 0%, 32%)",
        "line-dasharray": [3, 2],
        "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.5, 10, 1.5],
        "line-opacity": 0.6
      }
    },
    {
      "id": "buildings",
      "type": "fill",
      "source": "hungary-hiking",
      "source-layer": "buildings",
      "minzoom": 13,
      "layout": {"visibility": "visible"},
      "paint": {
        "fill-antialias": true,
        "fill-color": [
          "interpolate",
          ["linear"],
          ["zoom"],
          13,
          "hsl(58, 0%, 12%)",
          18,
          "hsl(58, 0%, 10%)"
        ],
        "fill-outline-color": "hsl(58, 0%, 11%)"
      }
    },
    {
      "id": "roads-casing",
      "type": "line",
      "source": "hungary-hiking",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": ["!in", "type", "footway", "path", "steps", "pedestrian"],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "hsl(0, 0%, 18%)",
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          ["match", ["get", "type"], "motorway", 1.5, 0],
          9,
          [
            "match",
            ["get", "type"],
            ["motorway", "trunk"],
            3,
            ["primary", "secondary"],
            2,
            0.5
          ],
          12,
          [
            "match",
            ["get", "type"],
            "motorway",
            8,
            "trunk",
            7,
            "primary",
            6,
            "secondary",
            5,
            "tertiary",
            4,
            ["residential", "unclassified", "living_street"],
            3,
            2
          ],
          14,
          [
            "match",
            ["get", "type"],
            "motorway",
            10,
            "trunk",
            9,
            "primary",
            8,
            "secondary",
            7,
            "tertiary",
            6,
            ["residential", "unclassified", "living_street"],
            5,
            3
          ],
          16,
          [
            "match",
            ["get", "type"],
            "motorway",
            16,
            "trunk",
            14,
            "primary",
            12,
            "secondary",
            10,
            "tertiary",
            8,
            ["residential", "unclassified", "living_street"],
            6,
            4
          ]
        ]
      }
    },
    {
      "id": "roads",
      "type": "line",
      "source": "hungary-hiking",
      "source-layer": "roads",
      "minzoom": 5,
      "filter": ["!in", "type", "footway", "path", "steps", "pedestrian"],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": [
          "match",
          ["get", "type"],
          "motorway",
          "hsl(26, 87%, 45%)",
          "trunk",
          "hsl(30, 84%, 40%)",
          "primary",
          "hsl(46, 77%, 35%)",
          "secondary",
          "hsl(60, 60%, 30%)",
          "tertiary",
          "hsl(0, 0%, 35%)",
          ["residential", "unclassified", "living_street"],
          "hsl(0, 0%, 38%)",
          ["service", "road", "minor"],
          "hsl(0, 0%, 32%)",
          "hsl(0, 0%, 35%)"
        ],
        "line-width": [
          "interpolate",
          ["linear"],
          ["zoom"],
          5,
          ["match", ["get", "type"], "motorway", 0.5, 0],
          9,
          [
            "match",
            ["get", "type"],
            ["motorway", "trunk"],
            1.5,
            ["primary", "secondary"],
            0.8,
            0.3
          ],
          12,
          [
            "match",
            ["get", "type"],
            "motorway",
            4,
            "trunk",
            3.5,
            "primary",
            2.5,
            "secondary",
            2,
            "tertiary",
            1.5,
            ["residential", "unclassified", "living_street"],
            1,
            ["service", "road", "minor"],
            0.5,
            1
          ],
          14,
          [
            "match",
            ["get", "type"],
            "motorway",
            6,
            "trunk",
            5,
            "primary",
            4,
            "secondary",
            3.5,
            "tertiary",
            3,
            ["residential", "unclassified", "living_street"],
            2,
            ["service", "road", "minor"],
            1,
            1.5
          ],
          16,
          [
            "match",
            ["get", "type"],
            "motorway",
            12,
            "trunk",
            10,
            "primary",
            8,
            "secondary",
            7,
            "tertiary",
            6,
            ["residential", "unclassified", "living_street"],
            4,
            ["service", "road", "minor"],
            2,
            3
          ]
        ]
      }
    },
    {
      "id": "footways",
      "type": "line",
      "source": "hungary-hiking",
      "source-layer": "roads",
      "minzoom": 14,
      "filter": ["in", "type", "footway", "path", "steps", "pedestrian"],
      "layout": {
        "line-cap": "round",
        "line-join": "round",
        "visibility": "visible"
      },
      "paint": {
        "line-color": "hsl(0, 0%, 28%)",
        "line-width": ["interpolate", ["linear"], ["zoom"], 14, 1, 16, 2],
        "line-dasharray": [2, 1]
      }
    },
    {
      "id": "road-labels",
      "type": "symbol",
      "source": "hungary-hiking",
      "source-layer": "roads",
      "minzoom": 12,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["coalesce", ["get", "name"], ["get", "ref"]],
        "text-font": ["Noto Sans Regular"],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          12,
          [
            "match",
            ["get", "type"],
            ["motorway", "trunk"],
            10,
            ["primary", "secondary"],
            9,
            8
          ],
          16,
          [
            "match",
            ["get", "type"],
            ["motorway", "trunk"],
            13,
            ["primary", "secondary"],
            12,
            11
          ]
        ],
        "symbol-placement": "line",
        "text-rotation-alignment": "map",
        "text-pitch-alignment": "viewport",
        "text-max-angle": 30
      },
      "paint": {
        "text-color": [
          "match",
          ["get", "type"],
          ["motorway", "trunk", "primary", "secondary"],
          "hsl(60, 80%, 75%)",
          "hsl(0, 0%, 65%)"
        ],
        "text-halo-color": "hsl(0, 0%, 10%)",
        "text-halo-width": 2,
        "text-opacity": ["interpolate", ["linear"], ["zoom"], 12, 0.7, 14, 1]
      }
    },
    {
      "id": "waterway-labels",
      "type": "symbol",
      "source": "hungary-hiking",
      "source-layer": "waterway",
      "minzoom": 13,
      "filter": ["has", "name"],
      "layout": {
        "text-field": ["get", "name"],
        "text-font": ["Noto Sans Regular"],
        "text-size": 10,
        "symbol-placement": "line",
        "text-rotation-alignment": "map"
      },
      "paint": {
        "text-color": "hsl(210, 60%, 55%)",
        "text-halo-color": "hsl(0, 0%, 10%)",
        "text-halo-width": 1.5
      }
    },
    {
      "id": "place-labels",
      "type": "symbol",
      "source": "hungary-hiking",
      "source-layer": "place_labels",
      "minzoom": 6,
      "layout": {
        "text-field": ["get", "name"],
        "text-font": [
          "case",
          ["==", ["get", "type"], "city"],
          ["literal", ["Noto Sans Bold"]],
          ["literal", ["Noto Sans Regular"]]
        ],
        "text-size": [
          "interpolate",
          ["linear"],
          ["zoom"],
          6,
          ["match", ["get", "type"], "city", 12, 10],
          12,
          ["match", ["get", "type"], "city", 18, "town", 15, "village", 12, 10],
          16,
          ["match", ["get", "type"], "city", 22, "town", 18, "village", 14, 12]
        ]
      },
      "paint": {
        "text-color": "hsl(0, 0%, 90%)",
        "text-halo-color": "hsl(0, 0%, 10%)",
        "text-halo-width": 2.5,
        "text-opacity": ["interpolate", ["linear"], ["zoom"], 6, 0.8, 10, 1]
      }
    }
  ],
  "id": "hungarian-map-dark"
}
